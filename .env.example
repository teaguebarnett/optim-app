# OPTIM — environment variables. Copy to .env.local for local development
# (.env.local is gitignored by Next.js's default .gitignore; never commit
# real values). See docs/production/FOUNDATION.md for the full setup
# checklist, including which of these are required per environment
# (local / Vercel Preview / Vercel Production).
#
# No real credentials belong in this file, ever — names and explanations
# only.

# ---------------------------------------------------------------------------
# Runtime mode — lib/production/mode.ts's resolveAppMode() reads this.
# "demo"     — the existing localStorage/fixture-backed prototype. Default
#              everywhere except a real Vercel Production deploy.
# "supabase" — real Supabase Auth + Postgres + Storage. REQUIRED for any
#              Vercel Production deployment — resolveAppMode() throws at
#              startup if VERCEL_ENV=production and this isn't "supabase".
# Deliberately NOT prefixed NEXT_PUBLIC_ — this must never be readable from
# (or spoofable by) the browser. See lib/production/mode.ts's module doc.
APP_MODE=demo

# ---------------------------------------------------------------------------
# Supabase — required when APP_MODE=supabase. From your Supabase project's
# Settings -> API page.
# ---------------------------------------------------------------------------

# Project URL. Safe to expose to the browser (NEXT_PUBLIC_) — every request
# it enables is still gated by RLS. See supabase/migrations/*.sql.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" API key. Also safe to expose — same reasoning as
# above. NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key. NEVER prefix this NEXT_PUBLIC_. Bypasses RLS
# entirely — only ever read by lib/supabase/admin.ts, a server-only module
# used for a small number of narrowly-scoped admin operations (sending
# invitations). Rotate immediately if this ever leaks.
SUPABASE_SERVICE_ROLE_KEY=

# The app's own public URL, used to build invitation/confirmation email
# links (lib/production/invite.ts). Set to your Vercel deployment URL in
# Preview/Production, or http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# One-time manual bootstrap (scripts/bootstrap-workspace.mts) — NOT read by
# the running app itself, only by that script when Teague runs it by hand
# once a real Supabase project exists. See that script's own header comment
# and docs/production/FOUNDATION.md's setup checklist.
# ---------------------------------------------------------------------------
# BOOTSTRAP_OWNER_EMAIL=teaguebarnett@gmail.com
# BOOTSTRAP_TEST_CLIENT_EMAIL=

# ---------------------------------------------------------------------------
# Automatically set by Vercel — do not set locally. Listed here only so
# lib/production/mode.ts's reliance on it is documented in one place.
# VERCEL_ENV=production | preview | development
# ---------------------------------------------------------------------------
